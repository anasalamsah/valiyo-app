rules_version = '2';

// Security rules for the valiyo-app Firestore database.
// This is the real security boundary for this project: the client SDK
// (used throughout lib/firestore/*) has no special privileges, so every
// collection must enforce ownership here regardless of what the app code
// requests. Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True only for the caller's own users/{uid} doc having role == "admin".
    // Assigning that role is a manual, backend/console-only operation —
    // nothing in this app lets a user set their own role.
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // users/{uid} — profile created/updated by the client on login.
    // Admins get a narrow bypass: they can look up any user (needed for
    // the email search in /admin/access) and update ONLY the `products`
    // map (grant/remove access) — they can never touch role, email, or
    // anyone's own identity fields.
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if (isOwner(uid) && request.resource.data.uid == uid && request.resource.data.role == resource.data.role)
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["products"]));
      allow delete: if false;
    }

    // user_access/{uid} — entitlements. Only a trusted backend (e.g. a
    // Lynk.id webhook running with the Admin SDK, which bypasses these
    // rules) may write this; the client is read-only.
    match /user_access/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // children — owned by the parent who created them.
    match /children/{childId} {
      allow read, update, delete: if isSignedIn() && resource.data.parentUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.parentUid == request.auth.uid;
    }

    // orders — written only by the trusted backend/webhook layer.
    match /orders/{orderId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // learn_progress — the Learn product writes progress for its own uid.
    match /learn_progress/{progressId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // discovery_results — the Discovery product writes results for its own uid.
    match /discovery_results/{resultId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // reports — generated by a backend/AI pipeline, read-only to the client.
    match /reports/{reportId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
