rules_version = '2';

// Security rules for the valiyo-app Firestore database.
// This is the real security boundary for this project: the client SDK
// (used throughout lib/firestore/*) has no special privileges, so every
// collection must enforce ownership here regardless of what the app code
// requests. Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True only for the caller's own users/{uid} doc having role == "admin".
    // Assigning that role is a manual, backend/console-only operation —
    // nothing in this app lets a user set their own role.
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // True if the caller's own account is entitled to `product`
    // ("learn" | "discovery"), checking BOTH access sources the app
    // recognizes — same merge logic as hasProductAccess() in
    // lib/firestore/access.ts, just enforced here so it can't be
    // bypassed by any client (this app, learn.valiyo.id,
    // discovery.valiyo.id, or a raw SDK call) that skips the UI-level
    // check.
    function hasProduct(product) {
      return isSignedIn() && (
        ( exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && product in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.products
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.products[product] == true )
        ||
        ( exists(/databases/$(database)/documents/user_access/$(request.auth.uid))
          && product in get(/databases/$(database)/documents/user_access/$(request.auth.uid)).data.products )
      );
    }

    // users/{uid} — profile created/updated by the client on login.
    // Admins get a narrow bypass: they can look up any user (needed for
    // the email search in /admin/access) and update ONLY the `products`
    // map (grant/remove access) — they can never touch role, email, or
    // anyone's own identity fields.
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if (isOwner(uid) && request.resource.data.uid == uid && request.resource.data.role == resource.data.role)
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["products"]));
      allow delete: if false;
    }

    // user_access/{uid} — entitlements. Only a trusted backend (e.g. a
    // Lynk.id webhook running with the Admin SDK, which bypasses these
    // rules) may write this; the client is read-only.
    match /user_access/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // pending_access/{email} — an admin pre-authorizes a purchased
    // customer by email BEFORE they've ever signed in (see
    // /admin/access → "Add Purchased Customer"). Only admins can create
    // or browse these. The one exception: a newly-signed-in user may
    // read and delete the single entry matching their own verified auth
    // email, so createUserIfNotExists() can consume it into their new
    // users/{uid}.products on first login.
    match /pending_access/{emailId} {
      function ownsEmail() {
        return isSignedIn() && request.auth.token.email != null
          && request.auth.token.email.lower() == emailId;
      }
      allow get: if isAdmin() || ownsEmail();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || ownsEmail();
    }

    // children — owned by the parent who created them.
    match /children/{childId} {
      allow read, update, delete: if isSignedIn() && resource.data.parentUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.parentUid == request.auth.uid;
    }

    // orders — written only by the trusted backend/webhook layer.
    match /orders/{orderId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // learn_progress — the Learn product writes progress for its own uid,
    // AND only while products.learn is granted. Without hasProduct('learn')
    // here, anyone signed in could read/write their own progress rows
    // regardless of purchase status — this is what actually gated the
    // "both products open regardless of what's granted" bug, since it's
    // enforced no matter which app (this one, or learn.valiyo.id) talks
    // to Firestore.
    match /learn_progress/{progressId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid && hasProduct('learn');
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid && hasProduct('learn');
      allow delete: if false;
    }

    // discovery_results — same entitlement gate as learn_progress above,
    // for products.discovery.
    match /discovery_results/{resultId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid && hasProduct('discovery');
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid && hasProduct('discovery');
      // Needed so completeAssessment() can delete the in-progress draft
      // right after saving the finished report — ownership is enough
      // here, no need to re-check current entitlement for a cleanup of a
      // doc the user already legitimately created.
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // reports — generated by a backend/AI pipeline, read-only to the client.
    match /reports/{reportId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
