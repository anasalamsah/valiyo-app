rules_version = '2';

// Security rules for Firebase Storage (separate product/config from
// Firestore — deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    // discovery-reports/{uid}/{reportId}.pdf — one generated PDF per
    // completed Discovery assessment. Only the owning parent can read or
    // write their own files.
    match /discovery-reports/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
